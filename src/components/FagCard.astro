---
export interface Props {
  navn: string;
  slug: string;
  ikon: string;
  beskrivelse: string;
  farge: string;
  oppgaveTell: number;
  kompetansemaalAntall: number;
}

const { navn, slug, ikon, beskrivelse, farge, oppgaveTell, kompetansemaalAntall } = Astro.props;
---

<a href={`/oppgaver-for-2IT/${slug}/`} class="fag-card">
  <div class="fag-icon" style={`background: ${farge}15; color: ${farge}`}>
    {ikon}
  </div>
  <div class="fag-content">
    <h3 class="fag-navn">{navn}</h3>
    <p class="fag-beskrivelse">{beskrivelse}</p>
    <div class="fag-stats">
      <span class="stat">{oppgaveTell} oppgaver</span>
      <span class="stat">{kompetansemaalAntall} kompetansemål</span>
    </div>
  </div>
  <div class="fag-pil">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M9 18l6-6-6-6" />
    </svg>
  </div>
</a>

<style>
  .fag-card {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.15s ease;
  }

  .fag-card:hover {
    border-color: var(--border-light);
    transform: translateY(-2px);
  }

  .fag-icon {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    flex-shrink: 0;
  }

  .fag-content {
    flex: 1;
  }

  .fag-navn {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
    letter-spacing: -0.02em;
  }

  .fag-beskrivelse {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 10px;
  }

  .fag-stats {
    display: flex;
    gap: 16px;
  }

  .stat {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .fag-pil {
    color: var(--text-muted);
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .fag-card:hover .fag-pil {
    transform: translateX(4px);
    color: var(--accent);
  }
</style>
