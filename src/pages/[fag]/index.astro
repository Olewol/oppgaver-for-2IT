---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import TaskCard from "../../components/TaskCard.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const fag = ["driftsstotte", "brukerstotte", "utvikling"];
  return fag.map((f) => ({
    params: { fag: f },
    props: { fagSlug: f },
  }));
}

const { fagSlug } = Astro.props;

const fagInfo = {
  driftsstotte: {
    navn: "Driftsstøtte",
    ikon: "🖥",
    farge: "#6c8cff",
    beskrivelse: "Planlegge, implementere og drifte fysiske og virtuelle IT-løsninger med fokus på sikkerhet, segmenterte nettverk, skytjenester og automatisering.",
    kompetansemaal: [
      { tema: "Driftsarkitektur", tekst: "Identifisere og utforske komponentar i ei driftsarkitektur og funksjonen til komponentane" },
      { tema: "Nettverkssegmentering", tekst: "Utforske og beskrive korleis segmenterte nettverk kan nyttast i ei verksemd" },
      { tema: "Skytjenester og virtualisering", tekst: "Utforske og samanlikne teknologiar for skytjenester og virtualisering" },
      { tema: "Bruker- og tilgangsstyring", tekst: "Utforske og drøfte prinsipp for brukar- og tilgangsstyring" },
      { tema: "Nettverksprotokoller", tekst: "Bruke adresseringsskjema, nettverksprotokollar og tenester i eit nettverk" },
      { tema: "Planlegging og dokumentasjon", tekst: "Planleggje og dokumentere oppsett, feilsøking og endringar av IT-løysingar" },
      { tema: "Trusler mot datasikkerhet", tekst: "Utforske og drøfte moglege trugsmål mot datasikkerheit" },
      { tema: "Risikoanalyse", tekst: "Gjere ein risikoanalyse for ei IT-løysing og foreslå risikoreduserende tiltak" },
      { tema: "Automatisering", tekst: "Utforske og drøfte bruk av automatisering i drift av IT-system" },
      { tema: "Sikre IT-løsninger", tekst: "Gjennomføre tiltak for å sikre ei IT-løysing" },
      { tema: "Personvern", tekst: "Utforske og drøfte korleis IT-løysingar påverkar personvern for enkeltmenneske, verksemder og samfunnet" },
      { tema: "Bærekraft", tekst: "Utforske og drøfte berekraftige løysingar og miljømedvitne val i drift av IT-system" },
    ],
  },
  brukerstotte: {
    navn: "Brukerstøtte",
    ikon: "💬",
    farge: "#4ade80",
    beskrivelse: "Service, veiledning og opplæring — kommunikasjon, feilsøking, dokumentasjon, kurs og kvalitetssikring for IT-systemer.",
    kompetansemaal: [
      { tema: "Etikk og lovverk", tekst: "Utforske og drøfte etiske problemstillingar og regelverk som gjeld for brukarstøtte" },
      { tema: "Brukerstøtte og veiledning", tekst: "Utforske og drøfte prinsipp for brukarstøtte og rettleiing" },
      { tema: "Utvikle veiledninger", tekst: "Utvikle og kvalitetssikre brukarrettleiingar og annan dokumentasjon" },
      { tema: "Kurs og opplæring", tekst: "Planleggje, gjennomføre og evaluere kurs og opplæring" },
      { tema: "Kommunikasjon og fagterminologi", tekst: "Bruke fagterminologi og kommunisere tilpassa målgruppa" },
      { tema: "Feilsøking", tekst: "Gjennomføre systemisk feilsøking" },
      { tema: "Kvalitetssikring", tekst: "Etablere system for kvalitetssikring av brukarstøtte" },
      { tema: "Krevende situasjoner", tekst: "Utforske og drøfte handtering av krevjande situasjonar i brukarstøtte" },
      { tema: "Intelligente systemer", tekst: "Utforske og drøfte korleis intelligente system kan nyttast i brukarstøtte" },
      { tema: "Samhandlingsverktøy", tekst: "Utforske og drøfte verktøy og metodar for samhandling" },
      { tema: "Yrkesfellesskap", tekst: "Utforske og drøfte korleis ein kan bidra til å utvikle eit godt yrkesfellesskap" },
    ],
  },
  utvikling: {
    navn: "Utvikling",
    ikon: "⚡",
    farge: "#fbbf24",
    beskrivelse: "Designe og utvikle IT-løsninger — programmering, webapplikasjoner, databaser, versjonskontroll, testing og innebygget sikkerhet.",
    kompetansemaal: [
      { tema: "Programmeringsspråk og algoritmer", tekst: "Utforske og bruke programmeringsspråk og algoritmar i ei IT-løysing" },
      { tema: "Funksjonelle krav", tekst: "Utarbeide funksjonelle krav til ei IT-løysing" },
      { tema: "Brukergrensesnitt", tekst: "Designe og utvikle eit brukargrensesnitt" },
      { tema: "Teknisk dokumentasjon", tekst: "Utarbeide teknisk dokumentasjon for ei IT-løysing" },
      { tema: "Versjonskontroll", tekst: "Bruke versionskontroll i utviklingsprosjekt" },
      { tema: "Innebygget personvern", tekst: "Utforske og drøfte prinsipp for innebygd personvern" },
      { tema: "Innebygget sikkerhet", tekst: "Utforske og drøfte prinsipp for innebygd sikkerheit" },
      { tema: "Testing", tekst: "Gjennomføre testing og kvalitetssikring av ei IT-løysing" },
      { tema: "Databasemodellering", tekst: "Utforske og samanlikne modellar for databasar" },
      { tema: "Datalagringsmodeller", tekst: "Utforske og samanlikne modellar for datalagring" },
    ],
  },
};

const info = fagInfo[fagSlug];

const oppgaver = (await getCollection("oppgaver"))
  .filter((o) => o.data.fag === fagSlug && o.data.publisert)
  .map((o) => {
    const slugParts = o.slug.split("/");
    const oppgaveSlug = slugParts[slugParts.length - 1];
    return { ...o, taskSlug: `${o.data.fag}/${oppgaveSlug}` };
  });
---

<BaseLayout title={`${info.navn} - Oppgaver for 2IT`}>
  <div class="layout">
    <Sidebar currentPath={`/${fagSlug}`} />
    <main class="main">
      <div class="fag-header">
        <div class="fag-icon" style={`background: ${info.farge}15; color: ${info.farge}`}>
          {info.ikon}
        </div>
        <div>
          <h1 class="fag-title">{info.navn}</h1>
          <p class="fag-desc">{info.beskrivelse}</p>
          <div class="fag-meta">
            <span class="fag-count">{oppgaver.length} oppgaver</span>
            <span class="fag-count">{info.kompetansemaal.length} kompetansemål</span>
          </div>
        </div>
      </div>

      <section class="km-section">
        <h2 class="section-title">Kompetansemål</h2>
        <div class="km-list">
          {info.kompetansemaal.map((km) => (
            <div class="km-item">
              <span class="km-tema">{km.tema}</span>
              <p class="km-tekst">{km.tekst}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="oppgaver-section">
        <h2 class="section-title">Oppgaver</h2>
        {oppgaver.length > 0 ? (
          <div class="oppgave-grid">
            {oppgaver.map((o) => (
              <TaskCard
                title={o.data.title}
                fag={o.data.fag}
                fagNavn={o.data.fag}
                emne={o.data.emne}
                kompetansemaal={o.data.kompetansemaal}
                vanskelighetsgrad={o.data.vanskelighetsgrad}
                tags={o.data.tags}
                slug={o.taskSlug}
                body={o.body}
              />
            ))}
          </div>
        ) : (
          <div class="tomt">
            <p>Ingen oppgaver publisert for dette faget ennå. Oppgaver kommer fortløpende.</p>
          </div>
        )}
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .layout {
    display: flex;
    min-height: 100vh;
  }

  .main {
    margin-left: var(--sidebar-width);
    flex: 1;
    max-width: 960px;
    padding: 48px 48px 80px;
  }

  .fag-header {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 40px;
  }

  .fag-icon {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    flex-shrink: 0;
  }

  .fag-title {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 6px;
    color: var(--text-primary);
  }

  .fag-desc {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 12px;
    max-width: 600px;
  }

  .fag-meta {
    display: flex;
    gap: 16px;
  }

  .fag-count {
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .km-section {
    margin-bottom: 48px;
  }

  .section-title {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 14px;
    color: var(--text-primary);
  }

  .km-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 8px;
  }

  .km-item {
    padding: 12px 14px;
    background: var(--bg-elevated);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }

  .km-tema {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .km-tekst {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .oppgaver-section {
    margin-bottom: 48px;
  }

  .oppgave-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 16px;
  }

  .tomt {
    padding: 32px;
    text-align: center;
    background: var(--bg-surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius-md);
  }

  .tomt p {
    color: var(--text-muted);
    font-size: 14px;
  }
</style>
